rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Trip Access Helpers
    function isTripParticipant(tripId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/trips/$(tripId)/participants/$(request.auth.uid)) ||
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.participantIds
      );
    }

    function isTripAdmin(tripId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/trips/$(tripId)/participants/$(request.auth.uid)).data.role == 'admin';
    }

    // 3. Entity Validations
    function isValidTrip(data) {
      return data.keys().hasAll(['name', 'destination', 'adminId', 'status', 'createdAt', 'updatedAt', 'groupSize', 'participantCount', 'participantIds']) &&
             data.name is string && data.name.size() <= 100 &&
             data.destination is string && data.destination.size() <= 200 &&
             data.groupSize is int && data.groupSize >= 1 && data.groupSize <= 50 &&
             data.participantCount is int && data.participantCount >= 0 &&
             data.adminId == request.auth.uid &&
             data.status in ['planning', 'confirmed', 'completed', 'cancelled'];
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['userId', 'role', 'status']) &&
             data.userId is string &&
             data.role in ['admin', 'member'] &&
             data.status in ['invited', 'joined', 'declined'];
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'userId', 'userName', 'createdAt']) &&
             data.text is string && data.text.size() <= 1000 &&
             data.userId == request.auth.uid;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'completed', 'createdBy', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.createdBy == request.auth.uid;
    }

    // 4. Collection Rules

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['displayName', 'email', 'createdAt']) &&
        incoming().email is string;
      allow update: if isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Trips
    match /trips/{tripId} {
      allow get: if isTripParticipant(tripId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow read: if isTripParticipant(tripId);
      
      allow create: if isSignedIn() && isValidTrip(incoming());
      
      allow update: if isTripAdmin(tripId) && isValidTrip(incoming()) && (
        // Prevent changing immutable fields
        incoming().adminId == existing().adminId &&
        incoming().createdAt == existing().createdAt &&
        // Strict field change control
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'destination', 'startDate', 'endDate', 'budget', 'groupSize', 'status', 'updatedAt', 'totalAmountDue', 'paidAmount', 'participantCount', 'participantIds'])
      );
      
      // Participants Sub-collection
      match /participants/{userId} {
        allow read: if isTripParticipant(tripId);
        allow create: if isSignedIn() && (request.auth.uid == userId || isTripAdmin(tripId)) && isValidParticipant(incoming());
        allow update: if (isOwner(userId) || isTripAdmin(tripId)) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'amountPaid', 'paid', 'insuranceSelected'])
        );
        allow delete: if isTripAdmin(tripId) && userId != request.auth.uid;
      }

      // Messages Sub-collection
      match /messages/{messageId} {
        allow read: if isTripParticipant(tripId);
        allow create: if isTripParticipant(tripId) && isValidMessage(incoming());
      }

      // Documents Sub-collection
      match /documents/{docId} {
        allow read: if isTripParticipant(tripId);
        allow create: if isTripParticipant(tripId) && 
          incoming().keys().hasAll(['name', 'url', 'uploadedById', 'createdAt']) &&
          incoming().uploadedById == request.auth.uid;
        allow delete: if isTripAdmin(tripId) || (isTripParticipant(tripId) && existing().uploadedById == request.auth.uid);
      }

      // Tasks Sub-collection
      match /tasks/{taskId} {
        allow read: if isTripParticipant(tripId);
        allow create: if isTripParticipant(tripId) && isValidTask(incoming());
        allow update: if isTripParticipant(tripId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'title', 'description', 'dueDate'])
        );
        allow delete: if isTripAdmin(tripId) || (isTripParticipant(tripId) && existing().createdBy == request.auth.uid);
      }
    }
  }
}
